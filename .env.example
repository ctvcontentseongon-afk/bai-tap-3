# ============================================================
# SEONGON Claude Workspace - Environment Variables Template
# Sao chép file này thành .env và điền giá trị thực
# ============================================================

# --- Skill: project-status-tracker ---
# Path tới service account JSON key (dùng cho Google Sheets)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service_account.json

# --- Skill: gsc-insights ---
# Path tới OAuth 2.0 client credentials (tải từ Google Cloud Console)
GSC_CLIENT_SECRETS_PATH=credentials/gsc_client_secrets.json
# Path lưu token sau khi xác thực OAuth (tự động tạo)
GSC_TOKEN_PATH=credentials/gsc_token.json

# --- Skill: client-report-monthly ---
# GSC site URL dạng sc-domain:example.com hoặc https://example.com/
GSC_SITE_URL=sc-domain:yourdomain.com
# GA4 Property ID (format: 123456789 — KHÔNG có "properties/")
GA4_PROPERTY_ID=your_ga4_property_id_here
# GA4 dùng chung service account với Google Sheets nếu đã grant quyền
GA4_SERVICE_ACCOUNT_PATH=credentials/service_account.json
# Ahrefs API Key (lấy tại: ahrefs.com → Settings → API)
AHREFS_API_KEY=your_ahrefs_api_key_here
